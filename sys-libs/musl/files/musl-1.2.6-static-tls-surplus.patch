+/* Give a runtime-loaded DSO a static TLS slot carved out of the
+ * surplus reserved at startup.  Threads which already exist own the
+ * storage, so only the TLS image has to be copied in and their DTV
+ * entries updated.  Returns 1 on success; 0 means the DSO keeps its
+ * dynamic TLS and initial-exec references to it must fail. */
+static int promote_static_tls(struct dso *dso)
+{
+	size_t off, base;
+
+	if (dso->static_tls) return 1;
+	if (!dso->tls.size || dso->tls.align > static_tls_align) return 0;
+	/* Offsets of surviving static slots are never rolled back, so
+	 * never hand out an overlapping one after a failed dlopen. */
+	base = tls_offset > static_tls_used ? tls_offset : static_tls_used;
+#ifdef TLS_ABOVE_TP
+	off = base + ((dso->tls.align-1) &
+		(-base + (uintptr_t)dso->tls.image));
+	if (off + dso->tls.size > static_tls_limit) return 0;
+	tls_offset = off + dso->tls.size;
+#else
+	off = base + dso->tls.size + dso->tls.align - 1;
+	off -= (off + (uintptr_t)dso->tls.image) & (dso->tls.align-1);
+	if (off > static_tls_limit) return 0;
+	tls_offset = off;
+#endif
+	static_tls_used = tls_offset;
+	dso->tls.offset = off;
+	dso->static_tls = 1;
+
+	if (dso->relocated) {
+		sigset_t set;
+		pthread_t self = __pthread_self(), td = self;
+		__block_app_sigs(&set);
+		__tl_lock();
+		do {
+			unsigned char *new = (void *)
+#ifdef TLS_ABOVE_TP
+				((char *)TP_ADJ(td) + off);
+#else
+				((char *)TP_ADJ(td) - off);
+#endif
+			memcpy(new, dso->tls.image, dso->tls.len);
+			if (td->dtv[0] >= dso->tls_id)
+				td->dtv[dso->tls_id] =
+					(uintptr_t)new + DTP_OFFSET;
+			td = td->next;
+		} while (td != self);
+		__tl_unlock();
+		__restore_sigs(&set);
+	}
+	return 1;
+}
