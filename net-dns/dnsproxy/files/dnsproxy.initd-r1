#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

pidfile="/var/run/dnsproxy.pid"
configfile="/etc/dnsproxy/config.yaml"
logfile="/var/log/dnsproxy.log"

depend() {
    provide dns
    need localmount net
    after bootmisc
}

start_pre() {
	if [ ! -f ${configfile} ]; then
	eerror "No config file at ${configfile}"
	return 1
	fi
}

start() {
	ebegin "Starting ${RC_SVCMANE}"
	start-stop-daemon --start \
	--background \
	--make-pidfile \
	--pidfile ${pidfile} \
	--exec "/usr/bin/dnsproxy" \
	-- --config-path=${configfile} \
	--output=${logfile}
	eend $?
}

stop() {
	ebegin "Stopping ${RC_SVCNAME}"
	start-stop-daemon --stop \
	--pidfile ${pidfile} \
	--retry "TERM/3/TERM/5"
	eend $?
}
