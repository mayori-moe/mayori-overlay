-lib/libc.so: $(LOBJS) $(LDSO_OBJS)
+# External allocator (mimalloc) as one position independent object.  It is
+# hosted code, so unlike musl itself it needs GNU extensions and the compiler
+# provided headers (notably <stdatomic.h>).
+#
+# MI_TLS_MODEL_PTHREADS is required: musl does not register the dynamic
+# linker's own PT_TLS segment (ldso/libc is special-cased in load_library),
+# so __thread variables in libc.so have no valid TLS module id.  mimalloc's
+# pthread based TLS model avoids libc TLS entirely.
+MIMALLOC_CFLAGS = -nostdinc -D_GNU_SOURCE -DMI_TLS_MODEL_PTHREADS=1 \
+	-I$(srcdir)/arch/$(ARCH) -I$(srcdir)/arch/generic \
+	-Iobj/src/internal -I$(srcdir)/src/internal -Iobj/include -I$(srcdir)/include \
+	-I$(MIMALLOC_DIR)/include -I$(MIMALLOC_DIR)/src
+
+obj/mimalloc.o: $(MIMALLOC_GLUE) $(GENH) $(IMPH)
+	$(CC) $(MIMALLOC_CFLAGS) $(CPPFLAGS) $(CFLAGS_AUTO) $(CFLAGS) \
+		-std=gnu11 -DNDEBUG -DMI_SECURE=1 -fPIC -fvisibility=hidden -fstack-protector-strong \
+		-isystem `$(CC) -print-file-name=include` \
+		-c -o $@ $<
+
+lib/libc.so: $(LOBJS) $(LDSO_OBJS) $(EXTRA_OBJ)
 	$(CC) $(CFLAGS_ALL) $(LDFLAGS_ALL) -nostdlib -shared \
-	-Wl,-e,_dlstart -o $@ $(LOBJS) $(LDSO_OBJS) $(LIBCC)
+	-Wl,-e,_dlstart -o $@ $(LOBJS) $(LDSO_OBJS) $(EXTRA_OBJ) $(LIBCC)
 
-lib/libc.a: $(AOBJS)
+lib/libc.a: $(AOBJS) $(EXTRA_OBJ)
 	rm -f $@
-	$(AR) rc $@ $(AOBJS)
+	$(AR) rc $@ $(AOBJS) $(EXTRA_OBJ)
 	$(RANLIB) $@
 
