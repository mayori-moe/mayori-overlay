#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="dnsproxy service for global dns processing"
command="/usr/bin/dnsproxy"
command_args="--config-path=/etc/dnsproxy/config.yaml"
command_background=true

pidfile="/var/run/${RC_SVCNAME}.pid"

output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    provide dns
    need localmount net
    after bootmisc
    use logger
}

start_pre() {
    if [ ! -f "/etc/dnsproxy/config.yaml" ]; then
        eerror "Config file not found!"
        return 1
    fi
}
