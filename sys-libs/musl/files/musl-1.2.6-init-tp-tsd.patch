--- a/src/internal/pthread_impl.h
+++ b/src/internal/pthread_impl.h
@@ -34,6 +34,7 @@ struct pthread {
 	/* Part 2 -- implementation details, non-ABI. */
 	int tid;
 	int errno_val;
+	void *malloc_tls[2];
 	volatile int detach_state;
 	volatile int cancel;
 	volatile unsigned char canceldisable, cancelasync;
