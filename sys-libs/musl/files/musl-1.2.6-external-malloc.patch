diff --git a/Makefile b/Makefile
index 3ad88b3..b338a01 100644
--- a/Makefile
+++ b/Makefile
@@ -18,7 +18,8 @@ libdir = $(prefix)/lib
 syslibdir = /lib
 
 MALLOC_DIR = mallocng
-SRC_DIRS = $(addprefix $(srcdir)/,src/* src/malloc/$(MALLOC_DIR) crt ldso $(COMPAT_SRC_DIRS))
+MALLOC_SRC_DIR = $(if $(filter external,$(MALLOC_DIR)),,src/malloc/$(MALLOC_DIR))
+SRC_DIRS = $(addprefix $(srcdir)/,src/* $(MALLOC_SRC_DIR) crt ldso $(COMPAT_SRC_DIRS))
 BASE_GLOBS = $(addsuffix /*.c,$(SRC_DIRS))
 ARCH_GLOBS = $(addsuffix /$(ARCH)/*.[csS],$(SRC_DIRS))
 BASE_SRCS = $(sort $(wildcard $(BASE_GLOBS)))
@@ -54,6 +55,9 @@ LDFLAGS_ALL = $(LDFLAGS_AUTO) $(LDFLAGS)
 
 AR      = $(CROSS_COMPILE)ar
 RANLIB  = $(CROSS_COMPILE)ranlib
+OBJCOPY = $(CROSS_COMPILE)objcopy
+NM      = $(CROSS_COMPILE)nm
+READELF = $(CROSS_COMPILE)readelf
 INSTALL = $(srcdir)/tools/install.sh
 
 ARCH_INCLUDES = $(wildcard $(srcdir)/arch/$(ARCH)/bits/*.h)
@@ -86,11 +90,45 @@ all:
 
 else
 
+ifeq ($(MALLOC_DIR),external)
+EXT_MALLOC_SKIP = obj/src/malloc/calloc.o obj/src/malloc/libc_calloc.o \
+	obj/src/malloc/free.o obj/src/malloc/realloc.o obj/src/malloc/lite_malloc.o
+LIBC_OBJS := $(filter-out $(EXT_MALLOC_SKIP),$(LIBC_OBJS))
+EXT_MALLOC_OBJ ?= obj/mimalloc.o
+MIMALLOC_DIR ?= $(srcdir)/../mimalloc
+MIMALLOC_GLUE ?= $(srcdir)/src/malloc/external/mimalloc-glue.c
+MIMALLOC_VERIFY ?= $(srcdir)/src/malloc/external/verify-syms.sh
+MIMALLOC_CFLAGS ?= -std=gnu11 -fPIC \
+	-fdata-sections -ffunction-sections -fno-semantic-interposition \
+	-fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc -fno-builtin-free \
+	-D_GNU_SOURCE -D_XOPEN_SOURCE=700 \
+	-I$(srcdir)/arch/$(ARCH) -I$(srcdir)/arch/generic -Iobj/src/internal \
+	-I$(srcdir)/src/include -I$(srcdir)/src/internal -Iobj/include -I$(srcdir)/include \
+	-I$(MIMALLOC_DIR)/include -I$(MIMALLOC_DIR)/src \
+	-nostdinc -isystem "$$($(CC) -print-file-name=include)" \
+	$(CPPFLAGS) $(CFLAGS) -O3
+
+MIMALLOC_KEEP_SYMS = \
+	--keep-global-symbol=malloc \
+	--keep-global-symbol=calloc \
+	--keep-global-symbol=realloc \
+	--keep-global-symbol=free \
+	--keep-global-symbol=aligned_alloc \
+	--keep-global-symbol=malloc_usable_size \
+	--keep-global-symbol=__libc_malloc \
+	--keep-global-symbol=__libc_malloc_impl \
+	--keep-global-symbol=__libc_calloc \
+	--keep-global-symbol=__libc_realloc \
+	--keep-global-symbol=__libc_free \
+	--keep-global-symbol=__malloc_donate \
+	--keep-global-symbol=__malloc_atfork
+endif
+
 all: $(ALL_LIBS) $(ALL_TOOLS)
 
-OBJ_DIRS = $(sort $(patsubst %/,%,$(dir $(ALL_LIBS) $(ALL_TOOLS) $(ALL_OBJS) $(GENH) $(GENH_INT))) obj/include)
+OBJ_DIRS = $(sort $(patsubst %/,%,$(dir $(ALL_LIBS) $(ALL_TOOLS) $(ALL_OBJS) $(GENH) $(GENH_INT) $(EXT_MALLOC_OBJ))) obj/include)
 
-$(ALL_LIBS) $(ALL_TOOLS) $(ALL_OBJS) $(ALL_OBJS:%.o=%.lo) $(GENH) $(GENH_INT): | $(OBJ_DIRS)
+$(ALL_LIBS) $(ALL_TOOLS) $(ALL_OBJS) $(ALL_OBJS:%.o=%.lo) $(GENH) $(GENH_INT) $(EXT_MALLOC_OBJ): | $(OBJ_DIRS)
 
 $(OBJ_DIRS):
 	mkdir -p $@
@@ -158,14 +196,30 @@ obj/%.lo: $(srcdir)/%.S
 obj/%.lo: $(srcdir)/%.c $(GENH) $(IMPH)
 	$(CC_CMD)
 
-lib/libc.so: $(LOBJS) $(LDSO_OBJS)
+ifeq ($(MALLOC_DIR),external)
+obj/mimalloc.o: $(MIMALLOC_GLUE) $(GENH) $(IMPH)
+	$(CC) $(MIMALLOC_CFLAGS) -c -o $@.raw $<
+	$(OBJCOPY) $(MIMALLOC_KEEP_SYMS) -R '.tbss*' $@.raw $@
+	rm -f $@.raw
+	@if [ -f "$(MIMALLOC_VERIFY)" ]; then \
+		NM="$(NM)" READELF="$(READELF)" sh "$(MIMALLOC_VERIFY)" obj $@; \
+	fi
+endif
+
+lib/libc.so: $(LOBJS) $(LDSO_OBJS) $(EXT_MALLOC_OBJ)
 	$(CC) $(CFLAGS_ALL) $(LDFLAGS_ALL) -nostdlib -shared \
-	-Wl,-e,_dlstart -o $@ $(LOBJS) $(LDSO_OBJS) $(LIBCC)
+	-Wl,-e,_dlstart -o $@ $(LOBJS) $(LDSO_OBJS) $(EXT_MALLOC_OBJ) $(LIBCC)
+	@if [ "$(MALLOC_DIR)" = "external" ] && [ -f "$(MIMALLOC_VERIFY)" ]; then \
+		NM="$(NM)" READELF="$(READELF)" sh "$(MIMALLOC_VERIFY)" dso $@; \
+	fi
 
-lib/libc.a: $(AOBJS)
+lib/libc.a: $(AOBJS) $(EXT_MALLOC_OBJ)
 	rm -f $@
-	$(AR) rc $@ $(AOBJS)
+	$(AR) rc $@ $(AOBJS) $(EXT_MALLOC_OBJ)
 	$(RANLIB) $@
+	@if [ "$(MALLOC_DIR)" = "external" ] && [ -f "$(MIMALLOC_VERIFY)" ]; then \
+		NM="$(NM)" READELF="$(READELF)" sh "$(MIMALLOC_VERIFY)" ar $@; \
+	fi
 
 $(EMPTY_LIBS):
 	rm -f $@
